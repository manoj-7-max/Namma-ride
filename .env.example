POSTGRES_DB=namma_ride
POSTGRES_USER=namma
POSTGRES_PASSWORD=replace-with-at-least-16-random-characters
ADMIN_API_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-at-least-32-random-characters
# Deprecated safety switch. The public API never returns OTP values.
EXPOSE_TEST_OTP=false
PILOT_OTP_ADMIN_API_KEY=replace-with-a-distinct-32-character-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PILOT_OTP_ENCRYPTION_KEY=replace-with-a-valid-44-character-fernet-key
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=900
MATCHING_RADIUS_KM=8
LOCATION_MAX_AGE_SECONDS=120
LOCATION_MAX_ACCURACY_M=100
LOCATION_MIN_INTERVAL_SECONDS=5
DISPATCH_OFFER_SECONDS=30
# Loopback only by default. Use 0.0.0.0 only for an intentional trusted-LAN test.
API_BIND_HOST=127.0.0.1
# JSON array containing only the deployed Admin origin and required local origins.
CORS_ORIGINS=["http://localhost:5173"]
