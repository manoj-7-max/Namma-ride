POSTGRES_DB=namma_ride
POSTGRES_USER=namma
POSTGRES_PASSWORD=replace-with-at-least-16-random-characters
ADMIN_API_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-at-least-32-random-characters
